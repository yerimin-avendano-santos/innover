# ========================================
# Dependencias
# ========================================
node_modules/

# ========================================
# Secretos
# ========================================
# ⛔ NUNCA subas archivos .env. Cada carpeta tiene su .env.example
# committed, que sí sirve de guía y no contiene secretos.
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# ========================================
# Backups de base de datos
# ========================================
# Contienen datos reales de usuarios.
backend/backups/

# ========================================
# Logs
# ========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp-*.log
tmp-*.err

# ========================================
# Compilaciones
# ========================================
.next/
out/
dist/
build/
*.tsbuildinfo

# ========================================
# Prisma
# ========================================
# El cliente generado se reconstruye con `prisma generate`.
backend/node_modules/.prisma/
backend/node_modules/@prisma/

# ========================================
# Sistema operativo y editores
# ========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================================
# Agentes de IA
# ========================================
# Las skills de Prisma se sincronizan solas con `prisma skills sync`.
# Duplicarlas en 4 carpetas (.claude, .cursor, .agents, .devin)
# genera ~375 KB de ruido en cada commit.
backend/.claude/
backend/.cursor/
backend/.devin/
backend/.agents/
