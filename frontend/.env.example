# ========================================
# 🎨 Variables de entorno del frontend
# ========================================
# Copia este archivo como ".env.local" y reemplaza el token.
#     cp .env.example .env.local
#
# ⛔ NUNCA subas el archivo .env.local a Git. Ya está en .gitignore.

# --- Token de Mapbox ---
# Consíguelo gratis en https://account.mapbox.com/access-tokens/
# Solo hace falta el token público (pk.…), que empieza por "pk".
NEXT_PUBLIC_MAPBOX_TOKEN=pk.pega_aqui_tu_token_publico

# --- URL del backend ---
# ⛔ Solo la ve el SERVIDOR de Next, nunca el navegador.
# El navegador llama a rutas relativas ("/api/...") y el servidor hace
# de intermediario hacia el backend. Por eso NO lleva NEXT_PUBLIC_.
#
# En producción será la URL de tu API desplegada:
#     BACKEND_URL=https://api.innover.com
BACKEND_URL=http://localhost:5000
