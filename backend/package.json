{
  "name": "innover-backend",
  "version": "3.0.0",
  "description": "API de INNOVER: plataforma inmobiliaria PropTech con mapas y CRM",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --watch server.js --watch src server.js",
    "start": "node server.js",
    "prueba": "node scripts/pruebas.mjs",
    "backup": "node scripts/backup-datos.mjs",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "verificar:geo": "node scripts/verificar-geografia.mjs",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "inmobiliaria",
    "proptech",
    "api",
    "express",
    "prisma",
    "postgis"
  ],
  "author": "INNOVER",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0"
  }
}
