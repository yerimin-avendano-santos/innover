# ========================================
# 🔐 Variables de entorno del backend
# ========================================
# Copia este archivo como ".env" y reemplaza los valores.
#     cp .env.example .env
#
# ⛔ NUNCA subas el archivo .env a Git.
# Ya está en .gitignore. Este .env.example sí se sube: sirve de guía.

# --- Servidor ---
PORT=5000
NODE_ENV=development

# --- Base de datos ---
# ⛔ Esta línea contiene tu contraseña. Nunca la publiques ni la compartas.
# La obtienes en el panel de tu proveedor (Supabase, Neon, Railway...).
DATABASE_URL="postgresql://usuario:CONTRASENA@host:puerto/nombre_db?schema=public"

# --- Autenticación ---
# Genera un secreto largo y aleatorio. Un comando:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# ⛔ En producción NO puede ser el valor de desarrollo. Si alguien elige
# el mismo secreto que tú, puede falsificar tokens y hacerse ADMIN.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_EN=2h

# Cuántos días dura la sesión sin volver a pedir la contraseña.
# Es la vida del token de renovación, el único que se puede revocar. Se renueva
# cada vez que se usa, así que son "30 días sin aparecer por aquí".
JWT_RENOVACION_DIAS=30

# --- Contraseñas ---
# 12 rondas de bcrypt. Más alto = más lento de romper.
BCRYPT_RONDAS=12

# --- CORS ---
# Orígenes que pueden llamar a la API, separados por comas.
# En producción pon aquí el dominio de tu frontend:
#     CORS_ORIGENES=https://innover.com,https://www.innover.com
CORS_ORIGENES=http://localhost:3000

# --- Rate limiting ---
# Intentos de login fallidos por IP cada 15 minutos.
RATE_LIMIT_AUTH=10
# Peticiones totales por IP cada 15 minutos.
RATE_LIMIT_GENERAL=300
# Escrituras por IP cada HORA (publicar una propiedad, mandar un lead).
# 📌 Los favoritos NO pasan por aquí: son privados y la clave única impide
# repetirlos, así que no hay nada que limitar.
# 20 es el tope de producción —está pensado para frenar el spam de anuncios—,
# pero en desarrollo se queda corto: cada corrida de la suite de integración
# gasta 21 (la del puente, 1 más), así que dos seguidas suman 42 y se cortarían
# a mitad, con decenas de fallos sueltos que parecen del código. El valor de
# aquí (60) da para dos corridas holgadas.
RATE_LIMIT_ESCRITURA=60
